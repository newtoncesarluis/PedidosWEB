{
  "name": "sysrepweb",
  "version": "1.0.0",
  "description": "Sistema de Vendas Web - SysRepWeb",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:win": "npx pkg . --targets node18-win-x64 --compress GZip --output dist/SysRepWeb.exe"
  },
  "pkg": {
    "scripts": [
      "config/**/*.js",
      "middleware/**/*.js",
      "modules/**/*.js",
      "routes/**/*.js",
      "services/**/*.js"
    ],
    "assets": [],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.7.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.6.0",
    "nodemailer": "^8.0.7",
    "puppeteer-core": "^24.42.0",
    "ssh2": "^1.17.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.20.0",
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}
