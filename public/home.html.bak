  { label:'Clientes Inativos',    sub:'Acesso Rápido',             tag:'Relatório', action:() => document.querySelector('.tl-item')?.click() },
  { label:'Top 10 Clientes',      sub:'Acesso Rápido',             tag:'Relatório', tlKey:'top-clientes' },
  { label:'Aniversariantes',      sub:'Acesso Rápido',             tag:'Relatório', tlKey:'aniversariantes' },
  { label:'Anotações',            sub:'Acesso Rápido',             tag:'Nota',      tlKey:'anotacoes' },
];

// Itens dinâmicos dos módulos são adicionados após carregamento
const _searchModulosExtra = [];

let _searchFocusIdx = -1;

function abrirBusca() {
  document.getElementById('search_overlay').classList.remove('hidden');
  document.getElementById('search_inp').value = '';
  _searchFocusIdx = -1;
  renderSearchResults('');
  setTimeout(() => document.getElementById('search_inp').focus(), 50);
}

function fecharBusca() {
  document.getElementById('search_overlay').classList.add('hidden');
}

function renderSearchResults(q) {
  const res = document.getElementById('search_results');
  const term = q.trim().toLowerCase();

  // Monta índice completo (estático + módulos carregados)
  const fullIndex = [...SEARCH_INDEX, ..._searchModulosExtra];

  const hits = term.length === 0
    ? fullIndex.slice(0, 12)
    : fullIndex.filter(i =>
        i.label.toLowerCase().includes(term) ||
        (i.sub || '').toLowerCase().includes(term) ||
        (i.tag || '').toLowerCase().includes(term)
      ).slice(0, 15);

  if (hits.length === 0) {
    res.innerHTML = `<div class="search-empty">Nenhum resultado para "<strong>${q}</strong>"</div>`;
    _searchFocusIdx = -1;
    return;
  }

  // Agrupa por categoria
  const byTag = {};
  hits.forEach(h => {
    const cat = h.tag || 'Outros';
    if (!byTag[cat]) byTag[cat] = [];
    byTag[cat].push(h);
  });

  let html = '';
  Object.entries(byTag).forEach(([cat, items]) => {
    html += `<div class="search-category">${cat}</div>`;
    items.forEach((item, i) => {
      html += `<div class="search-item" data-idx="${i}" onclick="executarBuscaItem(${JSON.stringify(item).replace(/"/g,'&quot;')})">
        <div class="search-item-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0
                 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <div class="search-item-text">
          <div class="search-item-label">${_highlight(item.label, term)}</div>
          ${item.sub ? `<div class="search-item-sub">${item.sub}</div>` : ''}
        </div>
        <span class="search-item-tag">${item.tag || ''}</span>
      </div>`;
    });
  });
  res.innerHTML = html;
  _searchFocusIdx = -1;
}

function _highlight(text, term) {
  if (!term) return text;
  const idx = text.toLowerCase().indexOf(term);
  if (idx === -1) return text;
  return text.substring(0, idx)
    + `<mark style="background:rgba(67,97,238,.15);color:var(--accent,#4361ee);border-radius:2px">${text.substring(idx, idx+term.length)}</mark>`
    + text.substring(idx + term.length);
}

function executarBuscaItem(item) {
  fecharBusca();

  if (item.tlKey) {
    const e = { preventDefault: () => {} };
    timelineClick(item.tlKey, e);
    return;
  }

  if (!item.page) return;

  // Ativa o módulo na sidebar se necessário
  if (item.modKey) {
    const menuEls = document.querySelectorAll('.menu-item');
    let modEl = null;
    menuEls.forEach(el => {
      const spanText = el.querySelector('span')?.textContent?.toLowerCase().trim();
      if (spanText && spanText.includes(item.modKey.replace('-', ''))) modEl = el;
    });
    // Tenta encontrar pelo key via onclick
    menuEls.forEach(el => {
      if ((el.onclick + '').includes(`'${item.modKey}'`)) modEl = el;
    });
    if (modEl) {
      _ativarMenuItem(modEl);
      if (SUBMENUS[item.modKey]) renderSubSidebar(item.modKey);
    }
  }

  // Marca sub-item se existir
  setTimeout(() => {
    document.querySelectorAll('.sub-item').forEach(s => {
      if ((s.getAttribute('data-key') || '') === item.subKey) {
        document.querySelectorAll('.sub-item').forEach(x => x.classList.remove('active'));
        s.classList.add('active');
      }
    });
  }, 50);

  // Carrega página em aba
  openTab(item.page, item.label || item.subKey || 'Página');
}

// Navegar com setas e Enter no input de busca
document.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
    e.preventDefault();
    if (document.getElementById('search_overlay').classList.contains('hidden')) abrirBusca();
    else fecharBusca();
    return;
  }
  if (e.key === 'Escape') {
    fecharBusca();
    return;
  }
  if (document.getElementById('search_overlay').classList.contains('hidden')) return;
  const items = document.querySelectorAll('.search-item');
  if (e.key === 'ArrowDown') {
    e.preventDefault();
    _searchFocusIdx = Math.min(_searchFocusIdx + 1, items.length - 1);
    items.forEach((el, i) => el.classList.toggle('focused', i === _searchFocusIdx));
    items[_searchFocusIdx]?.scrollIntoView({ block:'nearest' });
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    _searchFocusIdx = Math.max(_searchFocusIdx - 1, 0);
    items.forEach((el, i) => el.classList.toggle('focused', i === _searchFocusIdx));
    items[_searchFocusIdx]?.scrollIntoView({ block:'nearest' });
  } else if (e.key === 'Enter' && _searchFocusIdx >= 0) {
    items[_searchFocusIdx]?.click();
  }
});
</script>

<!-- ══ BUSCA OVERLAY ════════════════════════════════════════════════════════ -->
<div class="search-overlay hidden" id="search_overlay" onclick="if(event.target===this)fecharBusca()">
  <div class="search-box">
    <div class="search-input-wrap">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input class="search-input" id="search_inp" type="text"
        placeholder="Pesquisar telas, módulos, configurações..."
        oninput="renderSearchResults(this.value)"
        autocomplete="off" spellcheck="false">
      <span class="search-kbd">ESC para fechar</span>
    </div>
    <div class="search-results" id="search_results"></div>
    <div class="search-footer">
      <span><kbd>↑↓</kbd> navegar</span>
      <span><kbd>Enter</kbd> abrir</span>
      <span><kbd>Ctrl+K</kbd> alternar</span>
    </div>
  </div>
</div>

<!-- Botão flutuante Acesso Rápido -->
<button id="btn_show_timeline" onclick="mostrarTimeline()">
  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M13 10V3L4 14h7v7l9-11h-7z"/>
  </svg>
  Acesso Rápido
</button>

</body>
</html>
