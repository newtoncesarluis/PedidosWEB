const PAGES_PRONTAS = {
  // cadastros:  '/pages/cadastros.html',
  // comercial:  '/pages/comercial.html',
};

// ═══ MENSAGENS DE IFRAMES ════════════════════════════════════════════════════
window.addEventListener('message', (ev) => {
  if (!ev.data || ev.data.type !== 'acesso-rapido-visible') return;
  const btn = document.getElementById('btn_show_timeline');
  if (btn) btn.style.display = ev.data.visible ? '' : 'none';
});

// ═══ INIT ════════════════════════════════════════════════════════════════════
window.addEventListener('DOMContentLoaded', async () => {
  const token = sessionStorage.getItem('token') || localStorage.getItem('token');
  if (!token) { window.location.href = '/login.html?_=' + Date.now(); return; }

  // Verifica licença antes de carregar o sistema
  try {
    const lr = await fetch('/api/license/check');
    const ld = await lr.json();
    if (!ld.valid) {
      sessionStorage.removeItem('token');
      window.location.href = '/login.html?_=' + Date.now();
      return;
    }
  } catch { /* se não conseguir verificar, deixa continuar */ }

  // Mobile → redireciona para o app de força de vendas
  if (window.innerWidth < 900) {
    window.location.href = '/mobile-shell.html?_=' + Date.now();
    return;
  }

  const user    = JSON.parse(sessionStorage.getItem('user')    || '{}');
  const empresa = JSON.parse(sessionStorage.getItem('empresa') || '{}');

  window.App = { user, empresa, token, perm: user.permissoes || {} };

  // Top bar
  if (empresa.Razao_empresa) {
    document.getElementById('nome_empresa').textContent = empresa.Razao_empresa;
    document.getElementById('cnpj_empresa').textContent = empresa.cnpj || empresa.CNPJ || '—';
  }

  // Avatar e status bar
  const nome = user.nome || user.login || '?';
  document.getElementById('status_usuario').textContent = nome;
  document.getElementById('user_avatar').textContent = nome.charAt(0).toUpperCase();
  document.title = `SysPed WEB — ${nome}`;

  // Verificação periódica de licença — redireciona se bloqueada/expirada
  setInterval(async () => {
    try {
      const lr = await fetch('/api/license/check');
      const ld = await lr.json();
      if (!ld.valid) {
        sessionStorage.removeItem('token');
        sessionStorage.removeItem('user');
        sessionStorage.removeItem('empresa');
        window.location.href = '/login.html?_=' + Date.now();
      }
    } catch { /* ignora falha pontual de rede */ }
  }, 30000); // a cada 30 segundos

  // Aniversariantes
  const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho',
                 'Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  document.getElementById('label_aniversariantes').textContent =
    `Aniversariantes — ${meses[new Date().getMonth()]}`;

  await carregarModulos(token);
  carregarDashboard(token);
  verificarServidor(token);
  verificarBackup(token);
  verificarWhatsApp(token);
});

// ═══ MÓDULOS ════════════════════════════════════════════════════════════════
async function carregarModulos(token) {
  const sidebar = document.getElementById('sidebar_nav');
  try {
    const r = await fetch('/api/modulos', { headers: { Authorization: 'Bearer ' + token } });
    const data = await r.json();
    const modulos = data.modulos || [];

    const isMobile = window.innerWidth < 900;

    sidebar.innerHTML = '';
    modulos.forEach((m, i) => {
      const cfg = MODULO_CONFIG[m.descricao.toUpperCase().trim()];
      if (!cfg) return;

      // Configurações: ocultar no mobile
      if (cfg.key === 'configuracoes' && isMobile) return;

      const a = document.createElement('a');
      a.className = 'menu-item';
      a.href = '#';
      a.onclick = e => { e.preventDefault(); loadMenu(cfg.key, a); return false; };
      a.innerHTML = `<span class="menu-item-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">${cfg.svg}</svg></span><span>${cfg.label}</span>`;
      sidebar.appendChild(a);
      if (i === 0) _ativarMenuItem(a);
    });

    if (sidebar.children.length === 0) {
      sidebar.innerHTML = '<div class="menu-item" style="opacity:.4;pointer-events:none;font-size:10px">Sem módulos</div>';
    }
  } catch {
    sidebar.innerHTML = '<div class="menu-item" style="opacity:.4;pointer-events:none;font-size:10px">Erro</div>';
  }
}

// ═══ NAVEGAÇÃO ═══════════════════════════════════════════════════════════════
const MOD_LABELS = {
  cadastros:'Cadastros', comercial:'Comercial', compras:'Compras',
  estoque:'Estoque', expedicao:'Expedição', financeiro:'Financeiro',
  industria:'Industria', sac:'SAT / SAC', configuracoes:'Configurações', clinicas:'Clínicas'
};
const MOD_SVGS = {
  cadastros: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>',
  comercial: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>',
  compras:   '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>',
};

// ═══ SISTEMA DE ABAS ════════════════════════════════════════════════════════
let _tabs = [];        // [{id, label, page, iframe}]
let _activeTabId = null;

function openTab(page, label) {
  // Se já existe uma aba com essa page, só ativa
  const existing = _tabs.find(t => t.page === page);
  if (existing) { switchTab(existing.id); return; }

  const id = 'tab_' + Date.now();
  const container = document.getElementById('iframe-container');
  const iframe = document.createElement('iframe');
  iframe.src = page + (page.includes('?') ? '&' : '?') + '_v=' + Date.now();
  container.appendChild(iframe);

  _tabs.push({ id, label, page, iframe });
  container.style.display = 'block';
  document.getElementById('dash_scroll').style.display = 'none';
  renderTabBar();
  switchTab(id);
  ocultarTimeline();
}

function switchTab(id) {
  _activeTabId = id;
  _tabs.forEach(t => t.iframe.classList.remove('tab-ativa'));
  const tab = _tabs.find(t => t.id === id);
  if (tab) tab.iframe.classList.add('tab-ativa');
  document.getElementById('iframe-container').style.display = 'block';
  document.getElementById('dash_scroll').style.display = 'none';
  renderTabBar();
}

function closeTab(id, e) {
  if (e) e.stopPropagation();
  const idx = _tabs.findIndex(t => t.id === id);
  if (idx === -1) return;
  _tabs[idx].iframe.remove();
  _tabs.splice(idx, 1);

  if (_tabs.length === 0) {
    _activeTabId = null;
    document.getElementById('iframe-container').style.display = 'none';
    voltarHome();
  } else if (_activeTabId === id) {
    switchTab(_tabs[Math.max(0, idx - 1)].id);
  } else {
    renderTabBar();
  }
}

function renderTabBar() {
  const bar = document.getElementById('tab-bar');
  bar.innerHTML = _tabs.map(t => `
    <div class="tab${t.id === _activeTabId ? ' active' : ''}" onclick="switchTab('${t.id}')" title="${t.label}">
      <span class="tab-dot"></span>
      <span class="tab-label">${t.label}</span>
      <span class="tab-x" onclick="closeTab('${t.id}',event)" title="Fechar">✕</span>
    </div>`).join('');
  const activeEl = bar.querySelector('.tab.active');
  if (activeEl) activeEl.scrollIntoView({ block:'nearest', inline:'nearest' });
}

// ─── helpers para ativar/desativar ícone do módulo ──────────────────────────
function _ativarMenuItem(el) {
  document.querySelectorAll('.menu-item').forEach(m => {
    m.classList.remove('active');
    const ic = m.querySelector('.menu-item-icon');
    if (ic) {
      ic.style.background = '';
      ic.style.boxShadow = '';
      const svg = ic.querySelector('svg');
      if (svg) { svg.style.color = ''; svg.style.stroke = ''; }
    }
  });
  el.classList.add('active');
  const ic = el.querySelector('.menu-item-icon');
  if (ic) {
    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#4361ee';
    ic.style.background = accent;
    ic.style.boxShadow = '0 4px 14px rgba(0,0,0,.4)';
    const svg = ic.querySelector('svg');
    if (svg) { svg.style.color = '#fff'; svg.style.stroke = '#fff'; }
  }
}

function voltarHome() {
  // Desmarca todos os itens ativos
  document.querySelectorAll('.menu-item').forEach(m => {
    m.classList.remove('active');
    const ic = m.querySelector('.menu-item-icon');
    if (ic) { ic.style.background = ''; ic.style.boxShadow = ''; }
  });
  // Fecha sub-sidebar
  const subSidebar = document.getElementById('sub_sidebar');
  subSidebar.classList.add('collapsed');
  subSidebar.innerHTML = '';
  // Mostra dashboard
  const dashScroll = document.getElementById('dash_scroll');
  document.getElementById('iframe-container').style.display = 'none';
  dashScroll.style.display = 'flex';
  document.getElementById('kpi_row').style.display = '';
  document.querySelector('.chart-grid').style.display = '';
  document.querySelectorAll('.chart-card').forEach(c => c.style.display = '');
  document.getElementById('mod_placeholder')?.remove();
  // Reexibe a timeline
  mostrarTimeline();
}

function loadMenu(modulo, el) {
  _ativarMenuItem(el);

  const subSidebar = document.getElementById('sub_sidebar');
  const dashScroll = document.getElementById('dash_scroll');

  // Oculta a timeline ao entrar em qualquer módulo
  ocultarTimeline();

  // Módulo com submenus?
  if (SUBMENUS[modulo]) {
    renderSubSidebar(modulo);
    // Não carrega nada no conteúdo ainda; espera o usuário escolher sub-item
    return false;
  }

  // Fecha sub-sidebar se outro módulo for selecionado
  subSidebar.classList.add('collapsed');
  subSidebar.innerHTML = '';

  const page = PAGES_PRONTAS[modulo];
  if (page) {
    const label = MOD_LABELS[modulo] || modulo;
    openTab(page, label);
  } else {
    iframe.style.display = 'none';
    dashScroll.style.display = 'flex';
    const kpiRow = document.getElementById('kpi_row');
    kpiRow.style.display = 'none';
    document.querySelector('.chart-grid').style.display = 'none';
    document.querySelectorAll('.chart-card').forEach(c => c.style.display = 'none');
    document.getElementById('mod_placeholder')?.remove();
    const ph = document.createElement('div');
    ph.id = 'mod_placeholder';
    ph.className = 'mod-placeholder';
    ph.innerHTML = `
      <div class="mod-placeholder-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">${MOD_SVGS[modulo] || '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>'}</svg>
      </div>
      <strong>${MOD_LABELS[modulo] || modulo}</strong>
      <p>Módulo em desenvolvimento</p>`;
    dashScroll.appendChild(ph);
  }
  return false;
}

function renderSubSidebar(modulo) {
  const subSidebar = document.getElementById('sub_sidebar');
  const groups = SUBMENUS[modulo];
  const cfg = Object.values(MODULO_CONFIG).find(c => c.key === modulo) || {};
  const totalItems = groups.reduce((a, g) => a + g.items.length, 0);

  let itemsHtml = '';
  groups.forEach(g => {
    if (g.group) itemsHtml += `<div class="sub-group-header">${g.group}</div>`;
    g.items.forEach(item => {
      itemsHtml += `<a class="sub-item" href="#" data-page="${item.page}" data-key="${item.key}"
        onclick="loadSubItem('${item.page}', '${item.key}', '${item.label.replace(/'/g,"\\'")}', this); return false;">
        <span class="sub-item-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">${item.svg}</svg>
        </span>
        ${item.label}
      </a>`;
    });
  });

  subSidebar.innerHTML = `
    <div class="sub-header">
      <div class="sub-header-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">${cfg.svg || ''}</svg>
      </div>
      <div>
        <div class="sub-header-title">${cfg.label || modulo}</div>
        <div class="sub-header-sub">${totalItems} item${totalItems !== 1 ? 's' : ''}</div>
      </div>
    </div>
    <div class="sub-nav-body">${itemsHtml}</div>
  `;
  subSidebar.classList.remove('collapsed');
}

function loadSubItem(page, key, label, el) {
  document.querySelectorAll('.sub-item').forEach(s => s.classList.remove('active'));
  el.classList.add('active');
  openTab(page, label || key);
}

// ═══ TIMELINE VISIBILIDADE ═══════════════════════════════════════════════════
function ocultarTimeline() {
  const tl  = document.querySelector('.timeline-panel');
  const btn = document.getElementById('btn_show_timeline');
  if (!tl) return;
  tl.classList.add('tl-hidden');
  btn.style.display = 'inline-flex';
}
function mostrarTimeline() {
  const tl  = document.querySelector('.timeline-panel');
  const btn = document.getElementById('btn_show_timeline');
  if (!tl) return;
  tl.classList.remove('tl-hidden');
  btn.style.display = 'none';
}

// ═══ TIMELINE ════════════════════════════════════════════════════════════════
function timelineClick(tipo, event) {
  event.preventDefault();
  const token = sessionStorage.getItem('token') || localStorage.getItem('token');
  const endpoints = {
    'clientes-inativos':  '/api/clientes/inativos?dias=15',
    'top-clientes':       '/api/clientes/top?limit=10',
    'localizar-clientes': '/pages/localizar-clientes.html',
    'aniversariantes':    '/api/clientes/aniversariantes',
    'anotacoes':          '/pages/anotacoes.html',
  };
  const target = endpoints[tipo];
  if (!target) return;
  if (target.startsWith('/pages/')) {
    openTab(target, tipo.replace(/-/g,' ').replace(/\b\w/g, c => c.toUpperCase()));
  } else {
    window.open(target + (target.includes('?') ? '&' : '?') + 'token=' + token, '_blank');
  }
}

// ═══ SERVIDOR / BACKUP ════════════════════════════════════════════════════
function verificarServidor(token) {
  fetch('/api/auth/me', { headers: { Authorization: 'Bearer ' + token } })
    .then(r => {
      if (!r.ok) return;
      const el = document.getElementById('status_servidor');
      const ic = document.getElementById('icon_servidor');
      el.textContent = 'ON-LINE';
      el.className = 'sb-online';
      el.style.animation = 'none';
      ic.setAttribute('stroke','#4ade80');
    }).catch(() => {});
}

async function verificarBackup(token) {
  const el = document.getElementById('status_backup');
  try {
    const r = await fetch('/api/backup/status', { headers: { Authorization: 'Bearer ' + token } });
    if (!r.ok) { el.textContent = 'Backup: não verificado'; return; }
    const d = await r.json();
    if (d.dias === 0) {
      el.textContent = '✔ Backup hoje';
      el.className = 'sb-online';
    } else if (d.dias >= 1) {
      el.textContent = `⚠ Backup há ${d.dias} dia(s)`;
      el.className = d.dias > 3 ? 'sb-offline' : 'sb-warn';
    } else {
      el.textContent = 'Sem registro de backup';
      el.className = 'sb-warn';
    }
  } catch {
    el.textContent = 'Backup: não verificado';
  }
}

// ═══ TROCAR USUÁRIO ═══════════════════════════════════════════════════════
async function trocarUsuario() {
  if (!confirm('Deseja trocar de usuário? Você será redirecionado para o login.')) return;
  await fetch('/api/auth/logout', { method:'POST', credentials:'include' }).catch(()=>{});
  sessionStorage.clear();
  localStorage.removeItem('token');
  window.location.href = '/login.html?_=' + Date.now();
}

// ═══ DASHBOARD ═══════════════════════════════════════════════════════════════
const DASH_CORES = ['#42A5F5','#66BB6A','#FFA726','#AB47BC','#26C6DA','#FF7043','#7E57C2','#EC407A','#26A69A','#D4E157'];

async function carregarDashboard(token) {
  try {
    const r = await fetch('/api/dashboard/home', { headers: { Authorization:'Bearer ' + token } });
    if (!r.ok) return;
    const d = await r.json();

    // KPIs
    document.getElementById('dash_total').textContent =
      'R$ ' + (d.totalGeral || 0).toLocaleString('pt-BR', { minimumFractionDigits:2 });
    document.getElementById('dash_qtd').textContent = d.qtdPedidos || 0;
    document.getElementById('dash_mes').textContent  = d.mes || '—';

    // Qtd clientes únicos
    const qtdCli = d.topClientes?.length || 0;
    document.getElementById('dash_clientes').textContent = qtdCli;

    // Doughnuts
    const container = document.getElementById('dash_rosquinhas');
    container.innerHTML = '';
    const tipos = Object.entries(d.porTipo || {});

    if (tipos.length === 0) {
      container.innerHTML = '<div style="padding:20px;font-size:12px;opacity:.5;width:100%;text-align:center;color:var(--content-text,#999)">Sem dados no período</div>';
    } else {
      tipos.forEach(([tipo, valor], i) => {
        const pct = d.totalGeral > 0 ? ((valor / d.totalGeral) * 100).toFixed(0) : 0;
        const cor = DASH_CORES[i % DASH_CORES.length];
        const id  = 'rosca_' + i;
        const div = document.createElement('div');
        div.className = 'donut-item';
        div.innerHTML = `
          <div class="donut-wrap">
            <canvas id="${id}" width="80" height="80"></canvas>
            <div class="donut-pct">${pct}%</div>
          </div>
          <div class="donut-label">${tipo}</div>
          <div class="donut-val">R$ ${valor.toLocaleString('pt-BR',{minimumFractionDigits:2})}</div>`;
        container.appendChild(div);
        setTimeout(() => {
          new Chart(document.getElementById(id), {
            type:'doughnut',
            data:{ datasets:[{ data:[valor, Math.max(0, d.totalGeral - valor)],
              backgroundColor:[cor,'rgba(0,0,0,0.05)'], borderWidth:0 }] },
            options:{ cutout:'72%', plugins:{ legend:{display:false}, tooltip:{enabled:false} }, animation:{duration:700} }
          });
        }, 60 * i);
      });
    }

    // Bar clientes
    const ctxCli = document.getElementById('dash_chart_clientes')?.getContext('2d');
    if (ctxCli && d.topClientes?.length) {
      new Chart(ctxCli, {
        type:'bar',
        data:{
          labels: d.topClientes.map(c => c[0].length > 20 ? c[0].substring(0,18)+'…' : c[0]),
          datasets:[{ label:'Pedidos', data:d.topClientes.map(c=>c[1]),
            backgroundColor:'rgba(66,165,245,.8)', borderWidth:0, borderRadius:4 }]
        },
        options:{
          responsive:true,
          plugins:{ legend:{display:false} },
          scales:{
            x:{ grid:{display:false}, ticks:{font:{size:10}} },
            y:{ beginAtZero:true, ticks:{stepSize:1,font:{size:10}} }
          }
        }
      });
    }

    // Bar vendedores
    const ctxVend = document.getElementById('dash_chart_vendedores')?.getContext('2d');
    if (ctxVend && d.topVendedores?.length) {
      new Chart(ctxVend, {
        type:'bar',
        data:{
          labels: d.topVendedores.map(v => v[0].length > 20 ? v[0].substring(0,18)+'…' : v[0]),
          datasets:[{ label:'Pedidos', data:d.topVendedores.map(v=>v[1]),
            backgroundColor:'rgba(102,187,106,.8)', borderWidth:0, borderRadius:4 }]
        },
        options:{
          indexAxis:'y', responsive:true,
          plugins:{ legend:{display:false} },
          scales:{
            x:{ beginAtZero:true, ticks:{stepSize:1,font:{size:10}} },
            y:{ grid:{display:false}, ticks:{font:{size:10}} }
          }
        }
      });
    }
  } catch(e) {
    console.warn('Dashboard indisponível:', e.message);
  }
}

// ═══ WHATSAPP ════════════════════════════════════════════════════════════════
let whatsConectado = false;

async function verificarWhatsApp(token) {
  try {
    const r = await fetch('/api/whatsapp/status', { headers:{ Authorization:'Bearer ' + token } });
    const data = await r.json();
    const ok = data.status === 'open';
    _atualizarUIWhats(ok, data.instancia);
    return ok;
  } catch { return false; }
}

function _atualizarUIWhats(ok, instancia) {
  whatsConectado = ok;
  const btn    = document.getElementById('btn_whatsapp');
  const label  = document.getElementById('btn_whatsapp_label');
  const sbEl   = document.getElementById('status_whatsapp');

  if (ok) {
    btn.className = 'topbar-btn whats-on';
    label.textContent = 'WhatsApp Online';
    sbEl.textContent  = '● ' + (instancia || 'Conectado');
    sbEl.className    = 'sb-whats-on';
  } else {
    btn.className = 'topbar-btn';
    label.textContent = 'WhatsApp';
    sbEl.textContent  = 'WhatsApp desconectado';
    sbEl.className    = 'sb-whats-off';
  }
}

async function iniciarWhatsApp() {
  const token = sessionStorage.getItem('token') || localStorage.getItem('token');

  if (whatsConectado) {
    _modalConfirmarDesconectar(token);
    return;
  }

  // Verifica configuração
  let cfg = {};
  try {
    const r = await fetch('/api/whatsapp/config', { headers:{ Authorization:'Bearer ' + token } });
    cfg = await r.json();
  } catch {}

  if (!cfg.configurado) {
    _modalWhatsNaoConfigurado();
    return;
  }

  _modalQRCode(token);
}

// Modal: WhatsApp não configurado
