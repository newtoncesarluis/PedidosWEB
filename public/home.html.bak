<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SysPed WEB — Home</title>
<link rel="stylesheet" href="/assets/themes.css">
<script src="/assets/themes.js"></script>
<script>
  // Suprime o botão flutuante do themes.js — home.html tem botão Tema na topbar
  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('theme-fab')?.remove();
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    font-family:'Segoe UI',Arial,sans-serif;
    background:var(--sidebar-bg,#1e1e2e);
    height:100vh;
    display:flex;
    flex-direction:column;
    overflow:hidden;
    color:var(--content-text,#333);
    transition:background var(--transition,.2s);
  }

  /* ══ TOP BAR ══════════════════════════════════════════════════════ */
  .topbar {
    background:var(--topbar-bg,#1e1e2e);
    height:52px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 20px;
    border-bottom:1px solid var(--topbar-border,rgba(255,255,255,.08));
    flex-shrink:0;
    gap:12px;
    transition:background var(--transition);
    box-shadow:0 1px 0 var(--topbar-border,rgba(255,255,255,.06));
  }

  .topbar-brand {
    display:flex;
    align-items:center;
    gap:10px;
    min-width:200px;
  }
  .brand-icon {
    width:32px;height:32px;
    border-radius:8px;
    background:var(--accent,#4361ee);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .brand-icon svg { width:18px;height:18px;color:#fff; }
  .brand-name {
    display:flex;flex-direction:column;line-height:1.1;
  }
  .brand-name strong { font-size:13px;font-weight:700;color:var(--topbar-text,#fff); }
  .brand-name small { font-size:10px;color:var(--topbar-text,#aaa);opacity:.7; }

  .topbar-empresa {
    flex:1;
    text-align:center;
    font-size:12px;
    color:var(--topbar-text,#bbb);
    padding:0 12px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .topbar-empresa strong { color:var(--topbar-text,#fff);font-weight:600; }

  .topbar-actions {
    display:flex;align-items:center;gap:8px;min-width:200px;justify-content:flex-end;
  }

  .topbar-btn {
    display:flex;align-items:center;gap:6px;
    background:rgba(255,255,255,.08);
    color:var(--topbar-text,#ccc);
    border:1px solid rgba(255,255,255,.1);
    border-radius:8px;
    padding:6px 12px;
    font-size:12px;font-weight:500;
    cursor:pointer;
    transition:.2s;
    white-space:nowrap;
  }
  .topbar-btn:hover { background:rgba(255,255,255,.15);color:#fff; }
  .topbar-btn svg { width:14px;height:14px;flex-shrink:0; }

  .topbar-btn.whats-on { background:#25D366;border-color:#25D366;color:#fff; }
  .topbar-btn.whats-on:hover { background:#1ebe5d; }

  .user-avatar {
    width:32px;height:32px;border-radius:50%;
    background:var(--accent,#4361ee);
    color:#fff;font-size:12px;font-weight:700;
    display:flex;align-items:center;justify-content:center;
    cursor:pointer;flex-shrink:0;
    transition:opacity .2s;
    border:2px solid rgba(255,255,255,.2);
  }
  .user-avatar:hover { opacity:.85; }

  /* ══ LAYOUT ════════════════════════════════════════════════════════ */
  .main-wrapper {
    display:flex;flex:1;overflow:hidden;
  }

  /* ══ SIDEBAR ═══════════════════════════════════════════════════════ */
  .sidebar {
    width:72px;
    background:var(--sidebar-bg,#1e1e2e);
    display:flex;flex-direction:column;
    border-right:1px solid var(--sidebar-border,rgba(255,255,255,.06));
    flex-shrink:0;
    overflow-y:auto;
    overflow-x:hidden;
    transition:background var(--transition,.2s),width .25s ease;
    padding-top:8px;
  }
  .sidebar:hover { width:160px; }
  .sidebar::-webkit-scrollbar { width:3px; }
  .sidebar::-webkit-scrollbar-thumb { background:var(--sidebar-border,#555);border-radius:3px; }

  .menu-item {
    display:flex;align-items:center;gap:10px;
    padding:8px 10px;
    margin: 2px 6px;
    cursor:pointer;
    color:var(--sidebar-text,rgba(255,255,255,.55));
    transition:background .15s, color .15s;
    text-decoration:none;
    user-select:none;
    position:relative;
    white-space:nowrap;
    overflow:hidden;
    border-radius:10px;
  }
  .menu-item { border-left:3px solid transparent; }
  .menu-item:hover { color:var(--topbar-text,#fff);background:rgba(255,255,255,.08); }
  .menu-item.active {
    color:#fff;
    background:rgba(255,255,255,.1);
    border-left-color:var(--accent,#4361ee);
  }
  .menu-item-icon {
    width:36px;height:36px;border-radius:9px;
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
    background:rgba(255,255,255,.06);
    transition:background .2s,box-shadow .2s;
  }
  .menu-item:hover .menu-item-icon { background:rgba(255,255,255,.12); }
  .menu-item.active .menu-item-icon {
    background:var(--accent,#4361ee);
    box-shadow:0 4px 14px rgba(0,0,0,.35);
  }
  .menu-item.active .menu-item-icon svg { color:#fff;stroke:#fff; }
  .menu-item svg { width:20px;height:20px;flex-shrink:0; }
  .menu-item span:not(.menu-item-icon) { font-size:12px;font-weight:500;opacity:0;transition:opacity .15s; }
  .sidebar:hover .menu-item span:not(.menu-item-icon) { opacity:1; }

  /* ══ CONTEÚDO ══════════════════════════════════════════════════════ */
  .content-area {
    flex:1;
    background:var(--content-bg,#f4f5f7);
    overflow:hidden;
    position:relative;
    display:flex;
    flex-direction:column;
    transition:background var(--transition,.2s);
  }

  .content-iframe {
    width:100%;height:100%;border:none;display:block;
  }

  /* ── ABAS ──────────────────────────────────────────────────────── */
  #tab-bar {
    display:flex;align-items:center;
    background:var(--topbar-bg,#1a2035);
    border-bottom:1px solid rgba(255,255,255,.06);
    min-height:36px;padding:3px 8px;gap:2px;
    overflow-x:auto;flex-shrink:0;
    scrollbar-width:none;
  }
  #tab-bar:empty { display:none; }
  #tab-bar::-webkit-scrollbar { display:none; }
  .tab {
    display:flex;align-items:center;gap:5px;
    padding:4px 8px 4px 10px;
    font-size:11px;font-weight:400;
    cursor:pointer;white-space:nowrap;
    max-width:180px;min-width:60px;
    color:rgba(255,255,255,.38);
    border-radius:6px;
    border:none;
    transition:all .15s;user-select:none;
  }
  .tab:hover {
    color:rgba(255,255,255,.65);
    background:rgba(255,255,255,.06);
  }
  .tab.active {
    color:rgba(255,255,255,.9);
    background:rgba(255,255,255,.1);
    font-weight:500;
  }
  .tab-dot {
    width:5px;height:5px;border-radius:50%;
    background:currentColor;opacity:.4;flex-shrink:0;
    transition:opacity .15s;
  }
  .tab.active .tab-dot {
    opacity:1;
    background:var(--accent,#4361ee);
  }
  .tab-label { flex:1;overflow:hidden;text-overflow:ellipsis; }
  .tab-x {
    width:14px;height:14px;border-radius:3px;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;font-size:10px;
    opacity:0;transition:opacity .12s,background .12s,color .12s;
  }
  .tab:hover .tab-x, .tab.active .tab-x { opacity:.5; }
  .tab-x:hover { opacity:1 !important;background:rgba(239,68,68,.25) !important;color:#f87171 !important; }
  #iframe-container {
    flex:1;position:relative;overflow:hidden;display:none;
  }
  #iframe-container iframe {
    position:absolute;inset:0;width:100%;height:100%;
    border:none;display:none;
  }
  #iframe-container iframe.tab-ativa { display:block; }

  #dash_scroll {
    flex:1;overflow-y:auto;padding:20px;
    display:flex;flex-direction:column;gap:16px;
  }
  #dash_scroll::-webkit-scrollbar { width:6px; }
  #dash_scroll::-webkit-scrollbar-thumb { background:var(--sidebar-border,#ccc);border-radius:3px; }

  /* KPI CARDS */
  .kpi-row {
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:12px;
  }

  .kpi-card {
    background:var(--card-bg,#fff);
    border:1px solid var(--card-border,#e8eaed);
    border-radius:12px;
    padding:16px 20px;
    display:flex;flex-direction:column;gap:8px;
    position:relative;
    overflow:hidden;
    transition:box-shadow .2s,transform .2s;
  }
  .kpi-card:hover { box-shadow:0 4px 20px rgba(0,0,0,.08);transform:translateY(-1px); }
  .kpi-card::before {
    content:'';
    position:absolute;left:0;top:0;bottom:0;width:4px;
    background:var(--kpi-color,var(--accent,#4361ee));
    border-radius:0 0 0 0;
  }
  .kpi-top { display:flex;align-items:center;justify-content:space-between; }
  .kpi-label { font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--content-text,#888);opacity:.7; }
  .kpi-icon {
    width:34px;height:34px;border-radius:8px;
    display:flex;align-items:center;justify-content:center;
    background:var(--kpi-bg,rgba(67,97,238,.1));
    color:var(--kpi-color,var(--accent,#4361ee));
  }
  .kpi-icon svg { width:18px;height:18px; }
  .kpi-value { font-size:24px;font-weight:800;color:var(--content-text,#1e2433);line-height:1; }
  .kpi-sub { font-size:11px;color:var(--content-text,#999);opacity:.6; }

  /* CHART CARDS */
  .chart-grid {
    display:grid;
    grid-template-columns:280px 1fr;
    gap:12px;
  }
  @media (max-width:1100px) { .chart-grid { grid-template-columns:1fr; } }

  .chart-card {
    background:var(--card-bg,#fff);
    border:1px solid var(--card-border,#e8eaed);
    border-radius:12px;
    padding:16px 20px;
    display:flex;flex-direction:column;gap:12px;
  }
  .chart-title {
    font-size:12px;font-weight:700;text-transform:uppercase;
    letter-spacing:.5px;color:var(--content-text,#555);
    display:flex;align-items:center;gap:8px;
  }
  .chart-title span {
    width:8px;height:8px;border-radius:50%;
    background:var(--accent,#4361ee);flex-shrink:0;
  }

  /* DOUGHNUT GRID */
  .donut-grid {
    display:flex;flex-wrap:wrap;gap:16px;justify-content:center;
  }
  .donut-item {
    display:flex;flex-direction:column;align-items:center;gap:6px;
    min-width:90px;
  }
  .donut-wrap {
    position:relative;width:80px;height:80px;
  }
  .donut-pct {
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    font-size:14px;font-weight:800;color:var(--content-text,#333);
  }
  .donut-label { font-size:11px;font-weight:600;color:var(--content-text,#444);text-align:center; }
  .donut-val { font-size:10px;color:var(--accent,#4361ee);font-weight:500; }

  .dash-row2 {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
  }
  @media (max-width:900px) { .dash-row2 { grid-template-columns:1fr; } }

  /* EMPTY STATE */
  .dash-empty {
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:10px;padding:40px;color:var(--content-text,#bbb);text-align:center;
  }
  .dash-empty svg { width:48px;height:48px;opacity:.3; }
  .dash-empty strong { font-size:16px;opacity:.6; }
  .dash-empty p { font-size:13px;opacity:.4; }

  /* MODULE PLACEHOLDER */
  .mod-placeholder {
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    height:100%;gap:16px;color:var(--content-text,#bbb);
    padding:40px;
  }
  .mod-placeholder-icon {
    width:80px;height:80px;border-radius:20px;
    background:var(--card-bg,#f0f0f0);
    display:flex;align-items:center;justify-content:center;
    color:var(--accent,#4361ee);
    box-shadow:0 4px 20px rgba(67,97,238,.15);
  }
  .mod-placeholder-icon svg { width:40px;height:40px; }
  .mod-placeholder strong { font-size:22px;font-weight:700;color:var(--content-text,#555); }
  .mod-placeholder p { font-size:13px;opacity:.5; }

  /* ══ TIMELINE PANEL ════════════════════════════════════════════════ */
  .timeline-panel {
    width:290px;
    background:var(--card-bg,#fff);
    border-left:1px solid var(--timeline-border,#e8eaed);
    display:flex;flex-direction:column;
    flex-shrink:0;
    transition:width .25s ease, opacity .25s ease, background var(--transition,.2s),border-color var(--transition,.2s);
    overflow:hidden;
  }
  .timeline-panel.tl-hidden {
    width:0;
    opacity:0;
    border-left:none;
    pointer-events:none;
  }
  /* Botão flutuante para reabrir timeline */
  #btn_show_timeline {
    display:none;
    position:fixed;
    bottom:24px;
    right:20px;
    z-index:900;
    background:var(--accent,#4361ee);
    color:#fff;
    border:none;
    border-radius:22px;
    padding:9px 16px 9px 12px;
    font-size:12px;font-weight:600;
    cursor:pointer;
    align-items:center;gap:7px;
    box-shadow:0 4px 14px rgba(67,97,238,.4);
    transition:.2s;
    font-family:inherit;
  }
  #btn_show_timeline:hover { opacity:.9;transform:translateY(-1px); }
  #btn_show_timeline svg { width:14px;height:14px; }
  .timeline-panel::-webkit-scrollbar { width:4px; }
  .timeline-panel::-webkit-scrollbar-thumb { background:var(--timeline-border,#ccc);border-radius:4px; }

  .tl-header {
    padding:16px 20px 12px;
    border-bottom:1px solid var(--timeline-border,#eee);
    flex-shrink:0;
  }
  .tl-header-title {
    font-size:11px;font-weight:700;text-transform:uppercase;
    letter-spacing:.8px;color:var(--content-text,#999);
    display:flex;align-items:center;gap:8px;
  }
  .tl-header-title svg { width:14px;height:14px;color:var(--accent,#4361ee); }

  .tl-list { overflow-y:auto;flex:1; }
  .tl-list::-webkit-scrollbar { width:4px; }
  .tl-list::-webkit-scrollbar-thumb { background:var(--timeline-border,#ccc);border-radius:4px; }

  .tl-item {
    display:flex;align-items:center;gap:12px;
    padding:13px 20px;
    border-bottom:1px solid var(--timeline-border,rgba(0,0,0,.05));
    cursor:pointer;
    transition:background .15s;
    text-decoration:none;
  }
  .tl-item:hover { background:var(--timeline-item-hover,rgba(67,97,238,.04)); }
  .tl-item:last-child { border-bottom:none; }

  .tl-icon {
    width:38px;height:38px;border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    font-size:18px;flex-shrink:0;
    transition:.15s;
  }
  .tl-item:hover .tl-icon { transform:scale(1.05); }

  .tl-text { flex:1;min-width:0; }
  .tl-label {
    font-size:12px;font-weight:600;
    color:var(--timeline-link,#1a6ab1);
    line-height:1.3;
  }
  .tl-label.neutral { color:var(--content-text,#444); }
  .tl-sub { font-size:10px;color:var(--content-text,#aaa);margin-top:2px; }

  .tl-arrow {
    color:var(--content-text,#ccc);opacity:.4;flex-shrink:0;
  }
  .tl-arrow svg { width:14px;height:14px; }

  /* ══ STATUS BAR ════════════════════════════════════════════════════ */
  .statusbar {
    background:var(--statusbar-bg,#1e1e2e);
    height:30px;
    display:flex;align-items:center;
    border-top:1px solid var(--statusbar-border,rgba(255,255,255,.06));
    flex-shrink:0;
    font-size:11px;
    overflow:hidden;
    transition:background var(--transition,.2s);
  }
  .sb-seg {
    display:flex;align-items:center;gap:5px;
    padding:0 12px;height:100%;white-space:nowrap;
  }
  .sb-seg + .sb-seg { border-left:1px solid var(--statusbar-border,rgba(255,255,255,.08)); }
  .sb-seg svg { width:12px;height:12px;flex-shrink:0; }
  .sb-spacer { flex:1; }

  .sb-online  { color:#4ade80; }
  .sb-offline { color:#ff6b6b;animation:pulse-red 2s infinite; }
  .sb-warn    { color:#fbbf24; }
  .sb-info    { color:var(--statusbar-text,#aaa); }
  .sb-user    { color:var(--statusbar-text,#ddd);font-weight:500; }
  .sb-whats-on  { color:#4ade80;font-weight:600; }
  .sb-whats-off { color:var(--statusbar-text,#888); }

  @keyframes pulse-red {
    0%,100%{opacity:1} 50%{opacity:.4}
  }

  .btn-trocar {
    display:flex;align-items:center;gap:5px;
    background:none;border:none;
    color:var(--statusbar-text,#aaa);
    font-size:11px;cursor:pointer;padding:3px 8px;
    border-radius:4px;transition:.15s;
  }
  .btn-trocar:hover { background:rgba(255,255,255,.1);color:#fff; }

  /* ══ MODAIS ════════════════════════════════════════════════════════ */
  .modal-overlay {
    position:fixed;inset:0;z-index:9990;
    display:flex;align-items:center;justify-content:center;
    background:rgba(0,0,0,.55);
    backdrop-filter:blur(4px);
    padding:16px;
    animation:fadeIn .2s ease;
  }
  @keyframes fadeIn { from{opacity:0} to{opacity:1} }

  .modal-box {
    background:var(--card-bg,#fff);
    border-radius:16px;
    width:100%;max-width:400px;
    box-shadow:0 20px 60px rgba(0,0,0,.3);
    animation:slideUp .25s ease-out;
    overflow:hidden;
  }
  @keyframes slideUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }

  .modal-head {
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 20px;
    border-bottom:1px solid var(--card-border,#eee);
  }
  .modal-head h3 { font-size:15px;font-weight:700;color:var(--content-text,#1e2433); }
  .modal-close {
    width:28px;height:28px;border-radius:50%;
    background:none;border:none;cursor:pointer;
    color:var(--content-text,#888);font-size:16px;
    display:flex;align-items:center;justify-content:center;
    transition:.15s;
  }
  .modal-close:hover { background:var(--card-border,#f0f0f0); }

  .modal-body { padding:20px; }

  .modal-btn {
    display:flex;align-items:center;justify-content:center;gap:8px;
    width:100%;padding:11px;border:none;border-radius:10px;
    font-size:13px;font-weight:600;cursor:pointer;transition:.2s;
    margin-top:10px;
  }
  .modal-btn.primary { background:var(--accent,#4361ee);color:#fff; }
  .modal-btn.primary:hover { opacity:.9;transform:translateY(-1px); }
  .modal-btn.success { background:#25D366;color:#fff; }
  .modal-btn.success:hover { background:#1ebe5d; }
  .modal-btn.ghost { background:var(--card-border,#f0f0f0);color:var(--content-text,#555); }
  .modal-btn.ghost:hover { background:var(--timeline-border,#ddd); }
  .modal-btn svg { width:16px;height:16px; }

  /* ══ MOBILE ════════════════════════════════════════════════════════ */
  @media (max-width:900px) {
    .timeline-panel { display:none; }
    .chart-grid { grid-template-columns:1fr; }
  }
  @media (max-width:600px) {
    .sidebar { width:56px; }
    .topbar-empresa { display:none; }
    .sb-seg:nth-child(2) { display:none; }
    #dash_scroll { padding:12px; }
  }

  /* ══ SUB-SIDEBAR ════════════════════════════════════════════════════ */
  .sub-sidebar {
    width: 252px;
    background: var(--card-bg, #f8f9fc);
    border-right: 1px solid var(--card-border, #e2e6ef);
    box-shadow: 4px 0 16px rgba(0,0,0,.07);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow-y: auto;
    overflow-x: hidden;
    transition: width .25s ease, opacity .2s;
  }
  .sub-sidebar.collapsed {
    width: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0;
    pointer-events: none;
  }
  .sub-sidebar::-webkit-scrollbar { width: 4px; }
  .sub-sidebar::-webkit-scrollbar-thumb { background: var(--card-border, #ccc); border-radius: 4px; }

  /* Cabeçalho do módulo no sub-sidebar */
  .sub-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 16px 12px;
    border-bottom: 1px solid var(--card-border, #e2e6ef);
    background: var(--card-bg, #f8f9fc);
    flex-shrink: 0;
  }
  .sub-header-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: var(--accent, #4361ee);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .sub-header-icon svg { width: 16px; height: 16px; color: #fff; }
  .sub-header-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--content-text, #1e2433);
    letter-spacing: -.2px;
  }
  .sub-header-sub {
    font-size: 11px;
    color: var(--content-text, #888);
    opacity: .7;
    margin-top: 1px;
  }

  .sub-nav-body { padding: 8px 8px 24px; }

  .sub-group-header {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--content-text, #888);
    opacity: .55;
    padding: 16px 8px 6px;
    white-space: nowrap;
  }
  .sub-group-header:first-child { padding-top: 8px; }

  .sub-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    cursor: pointer;
    color: var(--content-text, #374151);
    font-size: 12.5px;
    font-weight: 500;
    transition: background .12s, color .12s;
    text-decoration: none;
    border-radius: 8px;
    white-space: nowrap;
    overflow: hidden;
    position: relative;
    margin-bottom: 1px;
  }
  .sub-item-icon {
    width: 28px; height: 28px;
    border-radius: 7px;
    background: var(--card-border, #eef0f5);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: background .12s;
  }
  .sub-item-icon svg { width: 14px; height: 14px; }
  .sub-item:hover { background: rgba(67,97,238,.07); color: var(--accent, #4361ee); }
  .sub-item:hover .sub-item-icon { background: rgba(67,97,238,.12); }
  .sub-item.active { background: rgba(67,97,238,.10); color: var(--accent, #4361ee); font-weight: 600; }
  .sub-item.active .sub-item-icon { background: rgba(67,97,238,.18); }
  .sub-item.active .sub-item-icon svg { stroke: var(--accent, #4361ee); }

  /* ══ BUSCA / COMMAND PALETTE ════════════════════════════════════════ */
  .search-overlay {
    position:fixed;inset:0;z-index:99999;
    display:flex;align-items:flex-start;justify-content:center;
    background:rgba(0,0,0,.55);backdrop-filter:blur(6px);
    padding:80px 16px 16px;
    animation:fadeIn .15s ease;
  }
  .search-overlay.hidden { display:none; }

  .search-box {
    background:var(--card-bg,#fff);
    border-radius:16px;
    width:100%;max-width:560px;
    box-shadow:0 24px 80px rgba(0,0,0,.35);
    overflow:hidden;
    animation:slideUp .18s ease-out;
  }

  .search-input-wrap {
    display:flex;align-items:center;gap:10px;
    padding:14px 18px;
    border-bottom:1px solid var(--card-border,#eee);
  }
  .search-input-wrap svg { width:18px;height:18px;color:var(--accent,#4361ee);flex-shrink:0; }
  .search-input {
    flex:1;border:none;outline:none;
    font-size:15px;font-weight:500;
    background:transparent;color:var(--content-text,#1e2433);
    font-family:inherit;
  }
  .search-input::placeholder { color:var(--content-text,#bbb);opacity:.5; }
  .search-kbd {
    font-size:10px;color:var(--content-text,#aaa);
    background:var(--card-border,#f0f0f0);
    padding:3px 7px;border-radius:5px;white-space:nowrap;flex-shrink:0;
  }

  .search-results {
    max-height:380px;overflow-y:auto;padding:6px 0;
  }
  .search-results::-webkit-scrollbar { width:4px; }
  .search-results::-webkit-scrollbar-thumb { background:var(--card-border,#ddd);border-radius:4px; }

  .search-category {
    font-size:10px;font-weight:700;text-transform:uppercase;
    letter-spacing:.8px;color:var(--content-text,#aaa);opacity:.6;
    padding:10px 18px 4px;
  }
  .search-item {
    display:flex;align-items:center;gap:12px;
    padding:10px 18px;cursor:pointer;
    transition:background .12s;
  }
  .search-item:hover, .search-item.focused {
    background:var(--timeline-item-hover,rgba(67,97,238,.07));
  }
  .search-item-icon {
    width:32px;height:32px;border-radius:8px;
    background:rgba(67,97,238,.1);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .search-item-icon svg { width:16px;height:16px;color:var(--accent,#4361ee); }
  .search-item-text { flex:1; }
  .search-item-label { font-size:13px;font-weight:600;color:var(--content-text,#1e2433); }
  .search-item-sub { font-size:11px;color:var(--content-text,#aaa);margin-top:1px; }
  .search-item-tag {
    font-size:10px;background:rgba(67,97,238,.1);color:var(--accent,#4361ee);
    padding:2px 8px;border-radius:10px;font-weight:600;flex-shrink:0;
  }

  .search-empty {
    text-align:center;padding:32px;color:var(--content-text,#bbb);font-size:13px;opacity:.6;
  }
  .search-footer {
    display:flex;align-items:center;gap:12px;
    padding:8px 18px;border-top:1px solid var(--card-border,#eee);
    font-size:11px;color:var(--content-text,#aaa);opacity:.7;
  }
  .search-footer kbd {
    background:var(--card-border,#f0f0f0);border-radius:4px;
    padding:2px 6px;font-size:10px;font-family:monospace;
  }
</style>
</head>
<body>

<!-- ══ TOP BAR ══════════════════════════════════════════════════════════════ -->
<div class="topbar">

  <div class="topbar-brand" onclick="voltarHome()" style="cursor:pointer" title="Voltar à tela inicial">
    <div class="brand-icon">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2
             2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1
             1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </div>
    <div class="brand-name">
      <strong>SysPed WEB</strong>
      <small>Tela Inicial</small>
    </div>
  </div>

  <div class="topbar-empresa">
    Liberado para&nbsp;<strong id="nome_empresa">—</strong>
    &nbsp;·&nbsp;
    CNPJ:&nbsp;<span id="cnpj_empresa">—</span>
  </div>

  <div class="topbar-actions">
    <!-- Botão busca -->
    <button class="topbar-btn" onclick="abrirBusca()" title="Buscar telas (Ctrl+K)">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      Buscar
    </button>

    <!-- Botão tema -->
    <button class="topbar-btn" onclick="window.SysTheme?.open()" title="Mudar Tema">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4
             4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2
             2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
      </svg>
      Tema
    </button>

    <!-- Botão WhatsApp -->
    <button class="topbar-btn" id="btn_whatsapp" onclick="iniciarWhatsApp()">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94
          1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198
          0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077
          4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.979-1.404A9.96 9.96 0 0012 22c5.523 0
          10-4.477 10-10S17.523 2 12 2zm0 18a7.964 7.964 0 01-4.072-1.115l-.292-.174-3.032.855.854-2.961-.19-.304A8
          8 0 1112 20z"/>
      </svg>
      <span id="btn_whatsapp_label">WhatsApp</span>
    </button>

    <!-- Avatar do usuário -->
    <div class="user-avatar" id="user_avatar" title="Usuário logado" onclick="trocarUsuario()">?</div>
  </div>

</div>

<!-- ══ LAYOUT ════════════════════════════════════════════════════════════════ -->
<div class="main-wrapper">

  <!-- SIDEBAR -->
  <nav class="sidebar" id="sidebar_nav">
    <div class="menu-item" style="opacity:.4;pointer-events:none">
      <span class="menu-item-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
          <circle cx="12" cy="12" r="8" stroke-width="1.5" stroke-dasharray="4"/>
        </svg>
      </span>
      <span>Carregando</span>
    </div>
  </nav>

  <!-- SUB-SIDEBAR -->
  <div class="sub-sidebar collapsed" id="sub_sidebar"></div>

  <!-- CONTEÚDO -->
  <div class="content-area" id="content_area">

    <!-- DASHBOARD HOME -->
    <div id="dash_scroll">

      <!-- KPIs -->
      <div class="kpi-row" id="kpi_row">
        <div class="kpi-card" style="--kpi-color:#4361ee;--kpi-bg:rgba(67,97,238,.1)">
          <div class="kpi-top">
            <span class="kpi-label">Total do Mês</span>
            <div class="kpi-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3
                     2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11
                     0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
          </div>
          <div class="kpi-value" id="dash_total">—</div>
          <div class="kpi-sub">Faturamento total do mês</div>
        </div>

        <div class="kpi-card" style="--kpi-color:#10b981;--kpi-bg:rgba(16,185,129,.1)">
          <div class="kpi-top">
            <span class="kpi-label">Qtd. Pedidos</span>
            <div class="kpi-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0
                     00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2
                     2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
              </svg>
            </div>
          </div>
          <div class="kpi-value" id="dash_qtd">—</div>
          <div class="kpi-sub">Pedidos lançados no mês</div>
        </div>

        <div class="kpi-card" style="--kpi-color:#f97316;--kpi-bg:rgba(249,115,22,.1)">
          <div class="kpi-top">
            <span class="kpi-label">Clientes Ativos</span>
            <div class="kpi-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7
                     20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0
                     0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
          </div>
          <div class="kpi-value" id="dash_clientes">—</div>
          <div class="kpi-sub">Clientes com pedidos no mês</div>
        </div>

        <div class="kpi-card" style="--kpi-color:#8b5cf6;--kpi-bg:rgba(139,92,246,.1)">
          <div class="kpi-top">
            <span class="kpi-label">Referência</span>
            <div class="kpi-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2
                     2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>
          <div class="kpi-value" id="dash_mes" style="font-size:17px;text-transform:capitalize">—</div>
          <div class="kpi-sub">Período atual</div>
        </div>
      </div>

      <!-- TIPOS DE PEDIDO + TOP CLIENTES -->
      <div class="chart-grid">
        <div class="chart-card">
          <div class="chart-title"><span></span>Tipos de Pedido</div>
          <div class="donut-grid" id="dash_rosquinhas">
            <div style="padding:20px;color:var(--content-text,#bbb);font-size:12px;opacity:.6;width:100%;text-align:center">Carregando...</div>
          </div>
        </div>

        <div class="chart-card">
          <div class="chart-title"><span style="background:#42A5F5"></span>Top Clientes do Mês</div>
          <canvas id="dash_chart_clientes"></canvas>
        </div>
      </div>

      <!-- RANKING VENDEDORES -->
      <div class="chart-card">
        <div class="chart-title"><span style="background:#66BB6A"></span>Ranking de Vendedores</div>
        <canvas id="dash_chart_vendedores" height="100"></canvas>
      </div>

    </div>

    <!-- BARRA DE ABAS -->
    <div id="tab-bar"></div>

    <!-- CONTAINER DE IFRAMES (uma por aba) -->
    <div id="iframe-container"></div>

  </div>

  <!-- TIMELINE -->
  <div class="timeline-panel">
    <div class="tl-header" style="display:flex;align-items:center;justify-content:space-between">
      <div class="tl-header-title">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Acesso Rápido
      </div>
      <button onclick="ocultarTimeline()" title="Ocultar" style="background:none;border:none;cursor:pointer;color:var(--content-text,#999);padding:2px 4px;font-size:16px;line-height:1;border-radius:4px;transition:.15s" onmouseover="this.style.color='var(--accent,#4361ee)'" onmouseout="this.style.color='var(--content-text,#999)'">✕</button>
    </div>

    <div class="tl-list">

      <a class="tl-item" href="#" onclick="timelineClick('clientes-inativos',event)">
        <div class="tl-icon" style="background:rgba(239,68,68,.1)">👥</div>
        <div class="tl-text">
          <div class="tl-label">Clientes Inativos</div>
          <div class="tl-sub">Sem compras há 15 dias</div>
        </div>
        <div class="tl-arrow"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
      </a>

      <a class="tl-item" href="#" onclick="timelineClick('top-clientes',event)">
        <div class="tl-icon" style="background:rgba(251,191,36,.1)">👑</div>
        <div class="tl-text">
          <div class="tl-label neutral">Top 10 Clientes</div>
          <div class="tl-sub">Maiores compradores do mês</div>
        </div>
        <div class="tl-arrow"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
      </a>

      <a class="tl-item" href="#" onclick="timelineClick('localizar-clientes',event)">
        <div class="tl-icon" style="background:rgba(59,130,246,.1)">🗺️</div>
        <div class="tl-text">
          <div class="tl-label">Localizar Clientes</div>
          <div class="tl-sub">Mapa de clientes por rota</div>
        </div>
        <div class="tl-arrow"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
      </a>

      <a class="tl-item" href="#" onclick="timelineClick('aniversariantes',event)">
        <div class="tl-icon" style="background:rgba(236,72,153,.1)">🎂</div>
        <div class="tl-text">
          <div class="tl-label neutral" id="label_aniversariantes">Aniversariantes do Mês</div>
          <div class="tl-sub">Clientes para parabenizar</div>
        </div>
        <div class="tl-arrow"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
      </a>

      <a class="tl-item" href="#" onclick="timelineClick('anotacoes',event)">
        <div class="tl-icon" style="background:rgba(16,185,129,.1)">📝</div>
        <div class="tl-text">
          <div class="tl-label neutral">Anotações</div>
          <div class="tl-sub">Lembretes e observações</div>
        </div>
        <div class="tl-arrow"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
      </a>

    </div>
  </div>

</div>

<!-- ══ STATUS BAR ════════════════════════════════════════════════════════════ -->
<div class="statusbar">

  <div class="sb-seg">
    <svg id="icon_servidor" fill="none" stroke="#ff6b6b" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round"
        d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905
           10.236-3.905 14.14 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/>
    </svg>
    <span class="sb-offline" id="status_servidor">OFF-LINE</span>
  </div>

  <div class="sb-seg">
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="sb-warn">
      <path stroke-linecap="round" stroke-linejoin="round"
        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464
           0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
    </svg>
    <span class="sb-warn" id="status_backup">Verificando backup...</span>
  </div>

  <div class="sb-seg">
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--statusbar-text,#888)">
      <path stroke-linecap="round" stroke-linejoin="round"
        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3
           20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
    </svg>
    <span class="sb-whats-off" id="status_whatsapp">WhatsApp não configurado</span>
  </div>

  <div class="sb-spacer"></div>

  <div class="sb-seg sb-user">
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round"
        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
    </svg>
    <span id="status_usuario">—</span>
  </div>

  <div class="sb-seg">
    <button class="btn-trocar" onclick="trocarUsuario()" title="Trocar usuário">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      Sair
    </button>
  </div>

</div>

<script>
// ═══ MÓDULO CONFIG ══════════════════════════════════════════════════════════
const MODULO_CONFIG = {
  'CADASTRO':    { key:'cadastros',    label:'Cadastros',    svg:'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>' },
  'COMERCIAL':   { key:'comercial',   label:'Comercial',    svg:'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>' },
