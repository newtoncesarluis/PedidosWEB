  { label:'Formas de Pagamento',                         sub:'Cadastros',  tag:'Cadastro', page:'/pages/formas-pagamento.html',   modKey:'cadastros', subKey:'formas-pagamento' },
  { label:'Regiões',                                     sub:'Cadastros',  tag:'Cadastro', page:'/pages/regioes.html',            modKey:'cadastros', subKey:'regioes' },
  { label:'Família de Produtos',                         sub:'Cadastros',  tag:'Cadastro', page:'/pages/familia-produtos.html',   modKey:'cadastros', subKey:'familia-produtos' },
  { label:'Motivo de Visitas',                           sub:'Cadastros',  tag:'Cadastro', page:'/pages/motivo-visitas.html',     modKey:'cadastros', subKey:'motivo-visitas' },
  { label:'Hotéis',                                      sub:'Cadastros',  tag:'Cadastro', page:'/pages/hoteis.html',             modKey:'cadastros', subKey:'hoteis' },
  { label:'Tipo de Frete',                               sub:'Cadastros',  tag:'Cadastro', page:'/pages/tipo-frete.html',         modKey:'cadastros', subKey:'tipo-frete' },
  { label:'Eventos / Cidades',                           sub:'Cadastros',  tag:'Cadastro', page:'/pages/eventos-cidades.html',    modKey:'cadastros', subKey:'eventos-cidades' },
  { label:'Perfil (Cadastro)',                           sub:'Cadastros',  tag:'Cadastro', page:'/pages/perfil-cad.html',         modKey:'cadastros', subKey:'perfil-cad' },
  { label:'Usuários (Cadastro)',                         sub:'Cadastros',  tag:'Cadastro', page:'/pages/usuarios-cad.html',       modKey:'cadastros', subKey:'usuarios-cad' },
  { label:'Natureza',                                    sub:'Cadastros',  tag:'Cadastro', page:'/pages/natureza.html',           modKey:'cadastros', subKey:'natureza' },
  { label:'Grades',                                      sub:'Cadastros',  tag:'Cadastro', page:'/pages/grades.html',             modKey:'cadastros', subKey:'grades' },
  { label:'Cadastro de Cores',                           sub:'Cadastros',  tag:'Cadastro', page:'/pages/cores.html',              modKey:'cadastros', subKey:'cores' },
  // Cadastros — Preços
  { label:'Tabela de Preços',                            sub:'Cadastros › Preços', tag:'Preço', page:'/pages/tabela-precos.html',      modKey:'cadastros', subKey:'tabela-precos' },
  { label:'Importação / Atualização de Preços (Planilhas)', sub:'Cadastros › Preços', tag:'Preço', page:'/pages/importacao-precos.html', modKey:'cadastros', subKey:'importacao-precos' },
  { label:'Atualização de Preços (Manual)',               sub:'Cadastros › Preços', tag:'Preço', page:'/pages/atualizacao-precos.html', modKey:'cadastros', subKey:'atualizacao-precos' },
  // Cadastros — Consultas Gerenciais
  { label:'Consulta de Clientes',                        sub:'Cadastros › Consultas', tag:'Consulta', page:'/pages/clientes.html', modKey:'cadastros', subKey:'consulta-clientes' },
