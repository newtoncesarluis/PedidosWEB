          Ir para Configurações
        </button>
        <button class="modal-btn ghost" onclick="document.getElementById('modal_whats_cfg').remove()">Fechar</button>
      </div>
    </div>`;
  m.addEventListener('click', e => { if (e.target === m) m.remove(); });
  document.body.appendChild(m);
}

// Modal: confirmar desconexão
function _modalConfirmarDesconectar(token) {
  _removeModal('modal_whats_off');
  const m = document.createElement('div');
  m.id = 'modal_whats_off';
  m.className = 'modal-overlay';
  m.innerHTML = `
    <div class="modal-box">
      <div class="modal-head">
        <h3>WhatsApp Conectado</h3>
        <button class="modal-close" onclick="document.getElementById('modal_whats_off').remove()">✕</button>
      </div>
      <div class="modal-body">
        <div style="text-align:center;padding:16px 0">
          <div style="font-size:48px;margin-bottom:12px">✅</div>
          <div style="font-size:14px;font-weight:600;color:var(--content-text,#333)">WhatsApp está online</div>
          <div style="font-size:12px;color:var(--content-text,#888);margin-top:6px">A instância está funcionando normalmente.</div>
        </div>
        <button class="modal-btn ghost" onclick="_desconectarWhats('${token}')">
          Desconectar instância
        </button>
        <button class="modal-btn primary" onclick="document.getElementById('modal_whats_off').remove()">Fechar</button>
      </div>
    </div>`;
  m.addEventListener('click', e => { if (e.target === m) m.remove(); });
  document.body.appendChild(m);
}

function _desconectarWhats(token) {
  _removeModal('modal_whats_off');
  _atualizarUIWhats(false, null);
  // TODO: chamar DELETE /api/whatsapp/disconnect quando endpoint disponível
}

// Modal: QR Code
async function _modalQRCode(token) {
  _removeModal('modal_qr');
  const m = document.createElement('div');
  m.id = 'modal_qr';
  m.className = 'modal-overlay';
  m.innerHTML = `
    <div class="modal-box">
      <div class="modal-head">
        <h3>Conectar WhatsApp</h3>
        <button class="modal-close" onclick="document.getElementById('modal_qr').remove()">✕</button>
      </div>
      <div class="modal-body" style="text-align:center">
        <div style="font-size:12px;color:var(--content-text,#888);margin-bottom:16px;line-height:1.5">
          Abra o WhatsApp no celular<br>
          <strong>Menu → Dispositivos vinculados → Vincular dispositivo</strong>
        </div>
        <div id="qr_area" style="width:220px;height:220px;margin:0 auto 16px;background:var(--card-border,#f5f5f5);border-radius:12px;display:flex;align-items:center;justify-content:center;overflow:hidden">
          <div style="color:var(--content-text,#bbb);font-size:12px">Carregando QR Code...</div>
        </div>
        <div id="qr_status" style="font-size:12px;color:var(--content-text,#999);margin-bottom:12px">Aguardando leitura do QR Code</div>
        <button class="modal-btn success" onclick="verificarConexaoQR('${token}')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Já escaneei — Verificar conexão
        </button>
        <button class="modal-btn ghost" onclick="document.getElementById('modal_qr').remove()" style="margin-top:6px">Cancelar</button>
      </div>
    </div>`;
  m.addEventListener('click', e => { if (e.target === m) m.remove(); });
  document.body.appendChild(m);

  try {
    const r = await fetch('/api/whatsapp/qrcode', { headers:{ Authorization:'Bearer '+token } });
    const data = await r.json();
    const area = document.getElementById('qr_area');
    if (data.qrcode) {
      area.innerHTML = `<img src="${data.qrcode}" style="width:100%;height:100%;object-fit:contain;border-radius:8px">`;
    } else {
      area.innerHTML = '<div style="color:#e53e3e;font-size:12px;padding:16px">Erro ao gerar QR Code</div>';
    }
  } catch {
    const area = document.getElementById('qr_area');
    if (area) area.innerHTML = '<div style="color:#e53e3e;font-size:12px;padding:16px">Erro de conexão</div>';
  }
}

async function verificarConexaoQR(token) {
  const st = document.getElementById('qr_status');
  if (st) st.textContent = 'Verificando...';
  const ok = await verificarWhatsApp(token);
  if (ok) {
    _removeModal('modal_qr');
  } else {
    if (st) st.textContent = 'Ainda não conectado — tente novamente.';
  }
}

function irParaConfiguracoes() {
  _removeModal('modal_whats_cfg');
  // Tenta clicar no item de menu Configurações se existir
  const cfgItem = [...document.querySelectorAll('.menu-item')]
    .find(el => el.textContent.trim().toLowerCase().includes('configura'));
  if (cfgItem) { cfgItem.click(); return; }
  // Fallback: mostra placeholder sem abrir iframe (evita recursão)
  const dashScroll = document.getElementById('dash_scroll');
  document.getElementById('iframe-container').style.display = 'none';
  dashScroll.style.display = 'flex';
  document.getElementById('kpi_row').style.display = 'none';
  document.querySelectorAll('.chart-grid, .chart-card').forEach(c => c.style.display = 'none');
  document.getElementById('mod_placeholder')?.remove();
  const ph = document.createElement('div');
  ph.id = 'mod_placeholder';
  ph.className = 'mod-placeholder';
  ph.innerHTML = `
    <div class="mod-placeholder-icon">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    </div>
    <strong>Configurações</strong>
    <p>Módulo em desenvolvimento</p>`;
  dashScroll.appendChild(ph);
}

function _removeModal(id) {
  document.getElementById(id)?.remove();
}

// ═══ BUSCA / COMMAND PALETTE ══════════════════════════════════════════════════
