# ── Banco operacional do cliente (MySQL dos dados / usuarios / pedidos) ─────
# Modo A — clássico: preencha DB_* e deixe CUSTOMER_DB_FROM_LICENSE comentado.
# Modo B — recomendado NC: CUSTOMER_DB_FROM_LICENSE=true → conexão vem do registro
#          da licença em sistema_licencas (mysql_host, mysql_user, …) ou PAINEL_API.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=pedidosweb_user
# DB_PASSWORD=SENHA_FORTE_AQUI
# DB_NAME=NOME_DO_BANCO_DELPHI
# CUSTOMER_DB_FROM_LICENSE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pedidosweb_user
DB_PASSWORD=SENHA_FORTE_AQUI
DB_NAME=NOME_DO_BANCO_DELPHI

# ── Segurança (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_FORTE_AQUI
SESSION_SECRET=GERE_OUTRA_CHAVE_ALEATORIA_AQUI

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=production
SYSTEM_NAME=PedidosWeb

# ── Chromium para geração de PDF (instalar com: sudo apt-get install -y chromium-browser) ──
CHROME_PATH=/usr/bin/chromium-browser

# ── Portal de gestão de licenças (/licencas.html) ────────────────────────────
DEV_EMAIL=admin@ncsistemas.com.br
DEV_PASSWORD=SENHA_DO_PAINEL_LICENCAS

# ── Painel: API opcional (se a licença não tiver colunas mysql_* preenchidas) ─
PAINEL_API_URL=http://147.15.106.135:3001
PAINEL_API_KEY=CHAVE_API_DO_PAINEL_LICENCAS

# ── Banco remoto de licenças NC Sistemas ────────────────────────────────────
LICENSE_DB_HOST=147.15.106.135
LICENSE_DB_PORT=3306
LICENSE_DB_NAME=sistema_licencas
LICENSE_DB_USER=USUARIO_LICENCAS
LICENSE_DB_PASSWORD=SENHA_LICENCAS

# ── Suporte (exibido quando licença é inválida) ───────────────────────────────
SUPORTE_NOME=NC Sistemas
SUPORTE_WHATSAPP=5514XXXXXXXXX
SUPORTE_EMAIL=suporte@ncsistemas.com.br

# ── PIX para renovação ───────────────────────────────────────────────────────
PIX_CHAVE=
PIX_TIPO=cpf
PIX_NOME=
PIX_DESCRICAO=Renovação de licença PedidosWeb
