    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────────────────────\n// ⚠️  CONFIGURE SEU NÚMERO (ALERTA_WHATSAPP do .env do SysRepWeb)\n//     Apenas dígitos: DDI + DDD + número\n// ─────────────────────────────────────────────────────────────\nconst ADMIN_NUMBER = '5514981120394';\n\nconst raw  = $input.first().json;\nconst body = raw.body ?? raw;          // n8n embala o body em .body\nconst data = body.data ?? {};\n\n// Ignora mensagens enviadas por nós (fromMe)\nif (data.key?.fromMe) return [];\n\n// Verifica se veio do número admin\nconst fromNum = String(data.key?.remoteJid ?? '')\n  .replace('@s.whatsapp.net', '')\n  .replace(/\\D/g, '');\n\nif (fromNum !== ADMIN_NUMBER) return [];\n\n// Verifica se há texto no comando\nconst msgText = (\n  data.message?.conversation ??\n  data.message?.extendedTextMessage?.text ??\n  ''\n).trim();\n\nif (!msgText) return [];\n\n// Passa o payload original (sem o wrapper do n8n) para o próximo nó\nreturn [{ json: body }];"
      },
      "id": "node-code-admin",
      "name": "👤 É do administrador?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
