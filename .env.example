# ── Modo BOUND (recomendado para Oracle VPS / SaaS) ──────────────────────────
# Amarra ESTE processo a UMA licença. O banco operacional vem diretamente da
# linha da licença na Oracle (mysql_host, mysql_user, mysql_database…).
# Um processo = um cliente = um banco. Isolamento 100% garantido.
# Gerado automaticamente pelo script novo-cliente.sh
# CHAVE_LICENCA=ABCD-1234-EFGH-5678

# ── Modo single-tenant local (dev / instalação única) ────────────────────────
# Usado quando CHAVE_LICENCA não está definido.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sysrepweb

# Modo legado multi-tenant (não recomendado — substitua por CHAVE_LICENCA):
# CUSTOMER_DB_FROM_LICENSE=true

# Segurança
JWT_SECRET=troque_por_uma_chave_secreta_forte_aqui
SESSION_SECRET=outra_chave_secreta_aqui
# Origens permitidas pelo CORS (vírgula entre múltiplas). Deixe vazio em dev (aceita localhost).
# Em produção: liste TODAS as origens de acesso (IP direto + domínio)
# ALLOWED_ORIGINS=http://147.15.106.135:3002,https://pedidos.nresolutions.com.br
ALLOWED_ORIGINS=

# Servidor
PORT=3002
NODE_ENV=development
SYSTEM_NAME=SysRepWeb

# Atrás de Nginx/proxy reverso — número de hops confiáveis (geralmente 1)
# TRUST_PROXY_HOPS=1

# ── Acesso ao portal de gestão de licenças (/licencas.html) ─────────────────
DEV_EMAIL=admin@empresa.com
DEV_PASSWORD=mudar@123

# ── Base de licenças MySQL (servidor remoto/central) ─────────────────────────
LICENSE_DB_HOST=
LICENSE_DB_PORT=3306
LICENSE_DB_NAME=sistema_licencas
LICENSE_DB_USER=
LICENSE_DB_PASSWORD=

# Opcional: se a linha de sistema_licencas não tiver mysql_host / mysql_user / … preenchidos,
# o app pode buscar credenciais do cliente via API do painel (POST /api/licenca/db-config).
# PAINEL_API_URL=http://127.0.0.1:3001
# PAINEL_API_KEY=

# ── Banco nc_painel (solicitações de suporte/melhoria) ───────────────────────
# Hostinger (mesma VPS): PAINEL_DB_HOST=127.0.0.1  PAINEL_DB_PORT=3306
# Dev local via túnel (tunnel-dev.bat [2]): PAINEL_DB_HOST=127.0.0.1  PAINEL_DB_PORT=3308
# PAINEL_DB_HOST=127.0.0.1
# PAINEL_DB_PORT=3306
# PAINEL_DB_NAME=nc_painel
# PAINEL_DB_USER=app_pedidosweb
# PAINEL_DB_PASSWORD=

# ── Ingestão de acessos no Painel NC (opcional) ───────────────────────────────
# PAINEL_ACESSOS_URL=https://painelnc.nresolutions.com.br
# PAINEL_ACESSOS_KEY=

# ── Onboarding DEMO (tela de boas-vindas — usa o mesmo Painel acima) ─────────
# DEMO_LANDING_URL=https://pedidos.nresolutions.com.br/landing.html?novo=1
# DEMO_USUARIO=ADMIN
# DEMO_SENHA=ADMIN
# Força a tela de boas-vindas neste servidor (mesmo se tipo_licenca não for "demo"):
# DEMO_ONBOARDING=1

# ── Informações de suporte (exibidas quando licença é inválida) ───────────────
SUPORTE_NOME=Suporte Técnico
SUPORTE_WHATSAPP=
SUPORTE_EMAIL=

# ── PIX para renovação (exibido quando licença expira) ───────────────────────
PIX_CHAVE=
PIX_TIPO=cpf
PIX_NOME=
PIX_DESCRICAO=Renovação de licença SysRepWeb

# ── Alertas de erro e relatório diário ──────────────────────────────────────
ALERTA_WHATSAPP=5514981120394        # número destino com DDI+DDD
ALERTA_WA_INSTANCIA=Nilton_Cesar     # nome da instância Evolution API (a do sistema)
ALERTA_EMAIL=newton.bauru@gmail.com  # email destino (usa SMTP abaixo)
# ALERTA_THROTTLE_MIN=5              # mínimos entre alertas do mesmo erro (padrão: 5)
# ALERTA_RELATORIO_HORARIOS=8,18     # horários do relatório diário (padrão: 08h e 18h)
#
# Se a Evolution API não estiver configurada na tabela 'configuracao' do banco, use:
# ALERTA_WA_URL=https://api.evolution...
# ALERTA_WA_APIKEY=minha-apikey
#
# SMTP para email (também usado para envio de pedidos, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@email.com
# SMTP_PASS=sua_senha_de_app
